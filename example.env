# =====================================================================
# GCP Environment & Application Configuration (example.env)
# Copy this file to .env and replace placeholders with your actual values.
# DO NOT commit .env to version control!
# =====================================================================

# --- 1. SHARED / CORE CONFIGURATION ---
GCP_PROJECT="edgar-rag-demo"
GCP_REGION="us-central1"
APP_NAME="itau-banking-alerts"
GEMINI_MODEL="gemini-3.7-flash"

# --- 2. LOCAL DEVELOPMENT CONFIGURATION ---
APP_ENV="local"
LOCAL_HOST="127.0.0.1"
LOCAL_PORT="8090"
DEBUG="true"
IAP_ENABLED_LOCAL="false"

# --- 3. PRODUCTION / GOOGLE CLOUD RUN CONFIGURATION ---
PROD_ENV="production"
SERVICE_ACCOUNT_NAME="itau-banking-alerts-sa"

# IAM Role Assignment: Specific user/group to grant roles/iap.httpsResourceAccessor in GCP IAM.
# Leave empty to automatically default to the current active gcloud user (user:$(gcloud config get-value account)).
# NOTE: Never put 'domain:google.com' here because GCP IAM Organization Policies block domain:google.com in IAM roles.
IAP_ALLOWED_MEMBER=""

# IAP Application Domain Allowlist: Domains permitted access through IAP at the application/JWT layer.
# The backend FastAPI middleware verifies that the user's verified IAP JWT (hd or email) matches these domains.
# Defaults to "google.com" (supports comma-separated values, e.g. "google.com,partner.com", or "*" for any authenticated domain).
IAP_ALLOWED_DOMAINS="google.com"

# Cloud Run Scaling & Resources
MIN_INSTANCES=0
MAX_INSTANCES=3
MEMORY="2Gi"
CPU="1"

# Optional: List of Secret Manager Secret Names used by this app (comma-separated)
REQUIRED_SECRETS=""
